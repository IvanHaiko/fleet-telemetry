    {
      "id": 6,
      "title": "Altitude MSL - live SQL history",
      "description": "Actual selected SQL measurements over the latest 10 native boot-clock minutes. Source boot time is not UTC. Historical samples remain when current state expires.",
      "type": "xychart",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "position-live"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "position-live"
          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "SELECT toFloat64(boot_ms)/1000 AS native_boot_seconds,altitude_msl_m FROM position_stream.positions WHERE boot_ms >= (SELECT max(boot_ms) FROM position_stream.positions)-600000 ORDER BY boot_ms SETTINGS max_execution_time=10,max_threads=1,max_memory_usage=268435456,max_rows_to_read=50000,max_bytes_to_read=64000000,read_overflow_mode='throw'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "lengthm",
          "noValue": "Unknown",
          "decimals": 3,
          "custom": {
            "show": "points+lines",
            "lineWidth": 1,
            "pointSize": {
              "fixed": 2
            },
            "axisLabel": "Altitude MSL (m)"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "native_boot_seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix:s"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.axisLabel",
                "value": "Source boot time (s)"
              }
            ]
          }
        ]
      },
      "options": {
        "mapping": "auto",
        "series": [
          {}
        ],
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "13.2.4"
    },
