    {
      "id": 9,
      "title": "Position estimate offset from first sample",
      "description": "Actual selected SQL measurements over the latest 10 native boot-clock minutes. Source boot time is not UTC. Historical samples remain when current state expires.",
      "type": "xychart",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "position-live"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "position-live"
          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "SELECT toFloat64(boot_ms)/1000 AS native_boot_seconds,(longitude_deg-(SELECT argMin(longitude_deg,boot_ms) FROM position_stream.positions))*pi()/180*6371000*cos(latitude_deg*pi()/180) AS east_m,(latitude_deg-(SELECT argMin(latitude_deg,boot_ms) FROM position_stream.positions))*pi()/180*6371000 AS north_m FROM position_stream.positions WHERE boot_ms >= (SELECT max(boot_ms) FROM position_stream.positions)-600000 ORDER BY boot_ms SETTINGS max_execution_time=10,max_threads=1,max_memory_usage=268435456,max_rows_to_read=50000,max_bytes_to_read=64000000,read_overflow_mode='throw'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "lengthm",
          "noValue": "Unknown",
          "decimals": 3,
          "custom": {
            "show": "points+lines",
            "lineWidth": 1,
            "pointSize": {
              "fixed": 2
            },
            "axisLabel": "Approximate estimate offset (m)"
          }
        },
        "overrides": [
