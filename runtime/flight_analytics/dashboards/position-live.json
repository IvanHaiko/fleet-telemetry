            "matcher": {
              "id": "byName",
              "options": "native_boot_seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix:s"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.axisLabel",
                "value": "Source boot time (s)"
              }
            ]
          }
        ]
