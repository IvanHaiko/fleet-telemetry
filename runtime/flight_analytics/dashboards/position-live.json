      "id": 1,
      "title": "Pipeline state",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "position-live"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "position-live"
          },
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "SELECT status FROM position_stream.live_state SETTINGS max_execution_time=10,max_threads=1,max_memory_usage=268435456,max_rows_to_read=50000,max_bytes_to_read=64000000,read_overflow_mode='throw'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unknown",
          "decimals": 3,
          "mappings": [
            {
              "type": "value",
              "options": {
                "fresh": {
                  "text": "LIVE",
                  "color": "green"
                },
                "stale": {
                  "text": "STALE",
                  "color": "orange"
                },
                "unknown": {
                  "text": "UNKNOWN",
                  "color": "red"
                },
                "catching_up": {
                  "text": "CATCHING UP",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "pluginVersion": "13.2.4"
    },
