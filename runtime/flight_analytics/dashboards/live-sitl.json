          "format": 1,
          "rawSql": "SELECT source_receipt_age_ms / 1000 AS age_s FROM ${database}.live_state SETTINGS readonly=1,max_execution_time=10,max_threads=1,max_memory_usage=268435456,max_rows_to_read=50000,max_bytes_to_read=64000000,read_overflow_mode='throw',max_result_rows=4096,max_result_bytes=4194304,result_overflow_mode='throw'"
