    {
      "id": 15,
      "title": "Run health",
      "type": "table",
      "description": "Data-quality checks over this run's facts (ADR-0056): each row counts violations of a rule declared in the data contracts; ok means none, fail means at least one, unknown means no facts were there to check. Coordinate checks count violations only and never show values. The same SQL runs in ops status, which also shows admission, Kafka, Flink, archive and resource signals that SQL does not hold.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "mvp-f09-clickhouse"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "pluginVersion": "13.2.4",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "mvp-f09-clickhouse"
          },
          "queryType": "table",
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT tupleElement(arrayJoin([tuple('identity_conflicts',toInt64(toInt64(count()) - toInt64(uniqExact(event_id)))),tuple('latitude_range',toInt64(countIf(latitude_deg < -90 OR latitude_deg > 90))),tuple('longitude_range',toInt64(countIf(longitude_deg < -180 OR longitude_deg > 180))),tuple('null_island',toInt64(countIf(latitude_deg = 0 AND longitude_deg = 0))),tuple('remaining_fraction_range',toInt64(countIf(remaining_fraction < 0 OR remaining_fraction > 1))),tuple('time_order',toInt64(arrayCount((a, b) -> b < a, arrayPopBack(arrayMap(x -> x.2, arraySort(groupArray(tuple(input_offset, native_time_boot_ms))))), arrayPopFront(arrayMap(x -> x.2, arraySort(groupArray(tuple(input_offset, native_time_boot_ms)))))))),tuple('voltage_nonnegative',toInt64(countIf(voltage_v < 0))),tuple('battery_values_iff_receipt_ordered',toInt64(countIf(battery_status != 'receipt_ordered' AND (isNotNull(voltage_v) OR isNotNull(current_a) OR isNotNull(remaining_fraction))))),tuple('state_values_iff_receipt_ordered',toInt64(countIf(state_status != 'receipt_ordered' AND (isNotNull(armed) OR isNotNull(base_mode_code) OR isNotNull(custom_mode_code) OR isNotNull(system_status_code))))),tuple('receipt_age',toInt64(countIf(multiIf(battery_status = 'receipt_ordered', isNull(battery_receipt_age_ms) OR battery_receipt_age_ms > 3000, battery_status = 'stale', isNull(battery_receipt_age_ms) OR battery_receipt_age_ms <= 3000, isNotNull(battery_receipt_age_ms)) OR multiIf(state_status = 'receipt_ordered', isNull(state_receipt_age_ms) OR state_receipt_age_ms > 3000, state_status = 'stale', isNull(state_receipt_age_ms) OR state_receipt_age_ms <= 3000, isNotNull(state_receipt_age_ms))))),tuple('status_domain',toInt64(countIf(battery_status NOT IN ('receipt_ordered','stale','unknown_after_restart','none') OR state_status NOT IN ('receipt_ordered','stale','unknown_after_restart','none'))))]) AS r,1) AS check_name,tupleElement(r,2) AS violations,multiIf(uniqExact(event_id) = 0,'unknown',tupl