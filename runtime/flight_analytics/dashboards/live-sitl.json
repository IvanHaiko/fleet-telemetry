  "panels": [
    {
      "id": 1,
      "title": "Live PX4 SITL session",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Simulated live source.** One PX4 SITL session through Kafka, Flink, the independent archive and archive-gated SQL (ADR-0054); not a physical vehicle or RF link. **Connection** is *observed* only while a source heartbeat arrived in the last 3 s and the gateway and serving reports are current; *stale* when the gateway is current but the source is silent; *unknown* when the gateway or serving report is missing or old. Current values show only while observed. Battery and state carry no measurement time: they are attached to a position by receipt order, never by measurement time."
      }
    },
    {
      "id": 2,
      "title": "Connection",
      "type": "stat",
      "description": "Derived from the gateway's own status time, the last source heartbeat receipt and serving progress. Missing data never renews health.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "mvp-f09-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "mvp-f09-clickhouse"
          },
          "queryType": "table",
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT connection FROM ${database}.live_state SETTINGS readonly=1,max_execution_time=10,max_threads=1,max_memory_usage=268435456,max_rows_to_read=50000,max_bytes_to_read=64000000,read_overflow_mode='throw',max_result_rows=4096,max_result_bytes=4194304,result_overflow_mode='throw'"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown"
        },
        "overrides": []
      }
    },
