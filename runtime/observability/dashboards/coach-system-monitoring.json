{
  "uid": "coach-system-monitoring",
  "title": "Telemetry - system monitoring",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "editable": false,
  "tags": [
    "telemetry",
    "two-host",
    "monitoring",
    "coach-demo"
  ],
  "timezone": "utc",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "description": "Native service and Flink metrics for the Ethernet two-host topology. Missing telemetry is not zero.",
  "links": [
    {
      "title": "GPS and flight analytics",
      "type": "link",
      "url": "/d/coach-flight-analytics",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Ethernet two-host system",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Laptop:** Flink and Kafka nodes 3/5/6. **PC:** Kafka nodes 1/2/4, archive, ClickHouse, Prometheus and Grafana. SSH forwards carry service metrics over Ethernet. Scrape health is reachability, not end-to-end correctness. Missing job metrics stay **Unknown**; operator records/s are not unique measurements/s. JVM heap excludes Python workers; process RSS excludes host RAM and page cache. Full host CPU/RAM/disk, Kafka broker/ISR and archive-worker metrics are not supplied by the foundation scrape config."
      }
    },
    {
      "id": 2,
      "title": "PC Prometheus",
      "type": "stat",
      "pluginVersion": "13.2.4",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"prometheus\"}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
