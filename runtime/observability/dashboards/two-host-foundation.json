{
  "uid": "fleet-two-host-foundation",
  "title": "Fleet telemetry - two-host foundation",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "editable": false,
  "tags": [
    "fleet",
    "two-host",
    "foundation"
  ],
  "timezone": "utc",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Placement and scope",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Laptop:** Flink JobManager and TaskManager. **PC:** ClickHouse, SeaweedFS, Prometheus and Grafana. Metrics cross the cable through an authenticated SSH tunnel. All six targets should be UP. **No Kafka processing job is submitted yet.** Empty operator/checkpoint panels are expected. Flink heap excludes Python workers and host RAM. PC process RSS excludes filesystem cache and host RAM. Windows disk/free-memory checks remain separate SSH admission checks."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "All component scrape health: 1 is UP",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}} / {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Laptop Flink JVM heap (excludes Python and host RAM)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"flink_(jobmanager|taskmanager)_Status_JVM_Memory_Heap_Used\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "PC process RSS (excludes host RAM and page cache)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=~\"archive|prometheus|grafana\"}",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "ClickHouseAsyncMetrics_MemoryResident{job=\"serving\"}",
          "legendFormat": "ClickHouse",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
